{
  "name": "sidebar-notes",
  "displayName": "Sidebar Notes",
  "description": "Fast, beautiful, offline-first Markdown notes in your VS Code sidebar. Zero clutter, full native power.",
  "version": "1.0.0",
  "publisher": "iiMuhammadRashed",
  "author": {
    "name": "Muhammad Rashed",
    "url": "https://github.com/iiMuhammadRashed"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iiMuhammadRashed/sidebar-notes"
  },
  "bugs": {
    "url": "https://github.com/iiMuhammadRashed/sidebar-notes/issues"
  },
  "homepage": "https://github.com/iiMuhammadRashed/sidebar-notes#readme",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "markdown",
    "notes",
    "sidebar",
    "knowledge-base",
    "todo",
    "wiki",
    "scratchpad",
    "journal",
    "docs"
  ],
  "categories": [
    "Other",
    "Snippets",
    "Formatters"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:sidebarNotes.explorer",
    "onCommand:sidebarNotes.newNote",
    "onCommand:sidebarNotes.searchNotes",
    "onCommand:sidebarNotes.openScratchpad"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sidebar-notes-container",
          "title": "Sidebar Notes",
          "icon": "media/icons/notes-activity.svg"
        }
      ]
    },
    "views": {
      "sidebar-notes-container": [
        {
          "id": "sidebarNotes.explorer",
          "name": "Sidebar Notes",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "sidebarNotes.newNote",
        "category": "Sidebar Notes",
        "title": "New Note",
        "icon": "$(new-file)"
      },
      {
        "command": "sidebarNotes.newFolder",
        "category": "Sidebar Notes",
        "title": "New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "sidebarNotes.openNote",
        "category": "Sidebar Notes",
        "title": "Open Note"
      },
      {
        "command": "sidebarNotes.openToSide",
        "category": "Sidebar Notes",
        "title": "Open to Side",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "sidebarNotes.renameNote",
        "category": "Sidebar Notes",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "sidebarNotes.deleteNote",
        "category": "Sidebar Notes",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "sidebarNotes.duplicateNote",
        "category": "Sidebar Notes",
        "title": "Duplicate Note",
        "icon": "$(copy)"
      },
      {
        "command": "sidebarNotes.toggleFavorite",
        "category": "Sidebar Notes",
        "title": "Toggle Favorite / Pin",
        "icon": "$(star-empty)"
      },
      {
        "command": "sidebarNotes.toggleArchive",
        "category": "Sidebar Notes",
        "title": "Toggle Archive",
        "icon": "$(archive)"
      },
      {
        "command": "sidebarNotes.searchNotes",
        "category": "Sidebar Notes",
        "title": "Search Notes",
        "icon": "$(search)"
      },
      {
        "command": "sidebarNotes.filterByTag",
        "category": "Sidebar Notes",
        "title": "Filter Notes by Tag",
        "icon": "$(tag)"
      },
      {
        "command": "sidebarNotes.clearTagFilter",
        "category": "Sidebar Notes",
        "title": "Clear Tag Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "sidebarNotes.moveNote",
        "category": "Sidebar Notes",
        "title": "Move Note to Folder..."
      },
      {
        "command": "sidebarNotes.copyNoteLink",
        "category": "Sidebar Notes",
        "title": "Copy Note Markdown Link",
        "icon": "$(link)"
      },
      {
        "command": "sidebarNotes.copyNotePath",
        "category": "Sidebar Notes",
        "title": "Copy Relative Path"
      },
      {
        "command": "sidebarNotes.revealInOS",
        "category": "Sidebar Notes",
        "title": "Reveal in File Manager"
      },
      {
        "command": "sidebarNotes.openScratchpad",
        "category": "Sidebar Notes",
        "title": "Open Today's Daily Scratchpad",
        "icon": "$(calendar)"
      },
      {
        "command": "sidebarNotes.refresh",
        "category": "Sidebar Notes",
        "title": "Refresh Notes",
        "icon": "$(refresh)"
      },
      {
        "command": "sidebarNotes.togglePreview",
        "category": "Sidebar Notes",
        "title": "Open Note Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "sidebarNotes.openSettings",
        "category": "Sidebar Notes",
        "title": "Open Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sidebarNotes.newNote",
          "group": "navigation@1",
          "when": "view == sidebarNotes.explorer"
        },
        {
          "command": "sidebarNotes.newFolder",
          "group": "navigation@2",
          "when": "view == sidebarNotes.explorer"
        },
        {
          "command": "sidebarNotes.searchNotes",
          "group": "navigation@3",
          "when": "view == sidebarNotes.explorer"
        },
        {
          "command": "sidebarNotes.refresh",
          "group": "navigation@4",
          "when": "view == sidebarNotes.explorer"
        },
        {
          "command": "sidebarNotes.openScratchpad",
          "group": "1_actions@1",
          "when": "view == sidebarNotes.explorer"
        },
        {
          "command": "sidebarNotes.clearTagFilter",
          "group": "1_actions@2",
          "when": "view == sidebarNotes.explorer"
        },
        {
          "command": "sidebarNotes.openSettings",
          "group": "2_config@1",
          "when": "view == sidebarNotes.explorer"
        }
      ],
      "view/item/context": [
        {
          "command": "sidebarNotes.openToSide",
          "group": "inline@1",
          "when": "view == sidebarNotes.explorer && viewItem == note"
        },
        {
          "command": "sidebarNotes.toggleFavorite",
          "group": "inline@2",
          "when": "view == sidebarNotes.explorer && viewItem == note"
        },
        {
          "command": "sidebarNotes.newNote",
          "group": "inline@1",
          "when": "view == sidebarNotes.explorer && (viewItem == folder || viewItem == rootFolder)"
        },
        {
          "command": "sidebarNotes.renameNote",
          "group": "2_modify@1",
          "when": "view == sidebarNotes.explorer && (viewItem == note || viewItem == folder)"
        },
        {
          "command": "sidebarNotes.duplicateNote",
          "group": "2_modify@2",
          "when": "view == sidebarNotes.explorer && viewItem == note"
        },
        {
          "command": "sidebarNotes.moveNote",
          "group": "2_modify@3",
          "when": "view == sidebarNotes.explorer && viewItem == note"
        },
        {
          "command": "sidebarNotes.toggleArchive",
          "group": "2_modify@4",
          "when": "view == sidebarNotes.explorer && viewItem == note"
        },
        {
          "command": "sidebarNotes.copyNoteLink",
          "group": "3_copy@1",
          "when": "view == sidebarNotes.explorer && viewItem == note"
        },
        {
          "command": "sidebarNotes.copyNotePath",
          "group": "3_copy@2",
          "when": "view == sidebarNotes.explorer && (viewItem == note || viewItem == folder)"
        },
        {
          "command": "sidebarNotes.revealInOS",
          "group": "4_system@1",
          "when": "view == sidebarNotes.explorer && (viewItem == note || viewItem == folder)"
        },
        {
          "command": "sidebarNotes.deleteNote",
          "group": "5_danger@1",
          "when": "view == sidebarNotes.explorer && (viewItem == note || viewItem == folder)"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sidebarNotes.newNote",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "sidebarNotes.searchNotes",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "sidebarNotes.openScratchpad",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "configuration": {
      "title": "Sidebar Notes",
      "properties": {
        "sidebarNotes.notesPath": {
          "type": "string",
          "default": ".notes",
          "description": "Workspace-relative folder path for storing project notes."
        },
        "sidebarNotes.globalNotesPath": {
          "type": "string",
          "default": "~/.sidebar-notes",
          "description": "Global folder path for notes available across all workspaces."
        },
        "sidebarNotes.defaultScope": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "default": "workspace",
          "description": "Default target location when creating new notes."
        },
        "sidebarNotes.sortBy": {
          "type": "string",
          "enum": [
            "modifiedDesc",
            "modifiedAsc",
            "titleAsc",
            "titleDesc",
            "createdDesc"
          ],
          "enumDescriptions": [
            "Recently modified first",
            "Oldest modified first",
            "Alphabetical by title (A-Z)",
            "Alphabetical by title (Z-A)",
            "Recently created first"
          ],
          "default": "modifiedDesc",
          "description": "Sort order for notes within folders and sections."
        },
        "sidebarNotes.showRecent": {
          "type": "boolean",
          "default": true,
          "description": "Show the Recent Notes section in the sidebar."
        },
        "sidebarNotes.recentLimit": {
          "type": "integer",
          "default": 7,
          "minimum": 1,
          "maximum": 30,
          "description": "Maximum number of recent notes to show."
        },
        "sidebarNotes.showFavorites": {
          "type": "boolean",
          "default": true,
          "description": "Show the Favorites / Pinned section in the sidebar."
        },
        "sidebarNotes.showTags": {
          "type": "boolean",
          "default": true,
          "description": "Show the Tags section in the sidebar."
        },
        "sidebarNotes.showArchive": {
          "type": "boolean",
          "default": false,
          "description": "Show the Archive section in the sidebar."
        },
        "sidebarNotes.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Display a Quick Note capture button on the status bar."
        },
        "sidebarNotes.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation dialog before deleting a note or folder."
        },
        "sidebarNotes.defaultNoteTemplate": {
          "type": "string",
          "default": "# ${title}\n\n",
          "description": "Template for newly created notes. Supports ${title}, ${date}, ${time}, ${datetime} variables."
        },
        "sidebarNotes.scratchpadTemplate": {
          "type": "string",
          "default": "# Daily Scratchpad - ${date}\n\n- [ ] \n",
          "description": "Template for daily scratchpad notes."
        },
        "sidebarNotes.dateFormat": {
          "type": "string",
          "default": "YYYY-MM-DD",
          "description": "Date format format string for templates and daily scratchpad naming."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "node esbuild.js --production",
    "build-dev": "node esbuild.js",
    "lint": "eslint src test --ext ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build-dev && npm run compile",
    "test": "node ./out/test/runTest.js",
    "test-unit": "mocha -r ts-node/register -r ./test/setup.ts 'test/suite/**/*.test.ts'",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.1",
    "eslint": "^8.57.0",
    "mocha": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
