{
  "name": "sidenote",
  "displayName": "Sidenote — Markdown Notes in Your Sidebar",
  "description": "Fast, offline-first Markdown notes in your VS Code sidebar. Workspace and global vaults, tags, wiki links, favorites and daily notes — all plain .md files.",
  "version": "1.0.0",
  "publisher": "iimuhammadrashed",
  "author": {
    "name": "Muhammad Rashed",
    "url": "https://github.com/iiMuhammadRashed"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iiMuhammadRashed/sidenote"
  },
  "bugs": {
    "url": "https://github.com/iiMuhammadRashed/sidenote/issues"
  },
  "homepage": "https://github.com/iiMuhammadRashed/sidenote#readme",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B0D14",
    "theme": "dark"
  },
  "qna": "marketplace",
  "keywords": [
    "markdown",
    "notes",
    "sidebar",
    "knowledge-base",
    "wiki",
    "daily-notes",
    "zettelkasten",
    "todo",
    "journal"
  ],
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Global notes require a local filesystem. In virtual workspaces only workspace-scoped notes are available."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sidenote-container",
          "title": "Sidenote",
          "icon": "media/icons/notes-activity.svg"
        }
      ]
    },
    "views": {
      "sidenote-container": [
        {
          "id": "sidenote.quickNote",
          "name": "Quick Note",
          "type": "webview"
        },
        {
          "id": "sidenote.explorer",
          "name": "Notes",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "sidenote.newNote",
        "category": "Sidenote",
        "title": "New Note",
        "icon": "$(new-file)"
      },
      {
        "command": "sidenote.newFolder",
        "category": "Sidenote",
        "title": "New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "sidenote.open",
        "category": "Sidenote",
        "title": "Open Note"
      },
      {
        "command": "sidenote.openToSide",
        "category": "Sidenote",
        "title": "Open Note to the Side",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "sidenote.rename",
        "category": "Sidenote",
        "title": "Rename Note or Folder",
        "icon": "$(edit)"
      },
      {
        "command": "sidenote.delete",
        "category": "Sidenote",
        "title": "Delete Note or Folder",
        "icon": "$(trash)"
      },
      {
        "command": "sidenote.search",
        "category": "Sidenote",
        "title": "Search Notes",
        "icon": "$(search)"
      },
      {
        "command": "sidenote.filterByTag",
        "category": "Sidenote",
        "title": "Filter Notes by Tag",
        "icon": "$(tag)"
      },
      {
        "command": "sidenote.clearTagFilter",
        "category": "Sidenote",
        "title": "Clear Tag Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "sidenote.copyWikiLink",
        "category": "Sidenote",
        "title": "Copy Wiki Link",
        "icon": "$(link)"
      },
      {
        "command": "sidenote.openDailyNote",
        "category": "Sidenote",
        "title": "Open Today's Daily Note",
        "icon": "$(calendar)"
      },
      {
        "command": "sidenote.refresh",
        "category": "Sidenote",
        "title": "Refresh Notes",
        "icon": "$(refresh)"
      },
      {
        "command": "sidenote.showPreview",
        "category": "Sidenote",
        "title": "Open Markdown Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "sidenote.openSettings",
        "category": "Sidenote",
        "title": "Open Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sidenote.newNote",
          "group": "navigation@1",
          "when": "view == sidenote.explorer"
        },
        {
          "command": "sidenote.newFolder",
          "group": "navigation@2",
          "when": "view == sidenote.explorer"
        },
        {
          "command": "sidenote.search",
          "group": "navigation@3",
          "when": "view == sidenote.explorer"
        },
        {
          "command": "sidenote.refresh",
          "group": "navigation@4",
          "when": "view == sidenote.explorer"
        },
        {
          "command": "sidenote.openDailyNote",
          "group": "1_actions@1",
          "when": "view == sidenote.explorer"
        },
        {
          "command": "sidenote.filterByTag",
          "group": "1_actions@2",
          "when": "view == sidenote.explorer"
        },
        {
          "command": "sidenote.clearTagFilter",
          "group": "1_actions@3",
          "when": "view == sidenote.explorer && sidenote.hasTagFilter"
        },
        {
          "command": "sidenote.openSettings",
          "group": "2_config@1",
          "when": "view == sidenote.explorer"
        }
      ],
      "view/item/context": [
        {
          "command": "sidenote.openToSide",
          "group": "inline@1",
          "when": "view == sidenote.explorer && viewItem == note"
        },
        {
          "command": "sidenote.newNote",
          "group": "inline@1",
          "when": "view == sidenote.explorer && viewItem == folder"
        },
        {
          "command": "sidenote.rename",
          "group": "2_modify@1",
          "when": "view == sidenote.explorer && (viewItem == note || viewItem == folder)"
        },
        {
          "command": "sidenote.copyWikiLink",
          "group": "3_copy@1",
          "when": "view == sidenote.explorer && viewItem == note"
        },
        {
          "command": "sidenote.delete",
          "group": "5_danger@1",
          "when": "view == sidenote.explorer && (viewItem == note || viewItem == folder)"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sidenote.newNote",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "sidenote.search",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "sidenote.openDailyNote",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "configuration": {
      "title": "Sidenote",
      "properties": {
        "sidenote.vaultPath": {
          "type": "string",
          "default": "~/.sidenote",
          "scope": "machine",
          "markdownDescription": "Folder holding every note Sidenote manages. It lives outside your projects, so notes are never committed by accident. Back it up or keep it in a private repo like any other folder."
        },
        "sidenote.projectNotesLocation": {
          "type": "string",
          "enum": [
            "vault",
            "repo"
          ],
          "enumDescriptions": [
            "Keep this project's notes privately in the vault (recommended)",
            "Keep them inside the project folder, where your team will see them"
          ],
          "default": "vault",
          "markdownDescription": "Where notes for the current project are stored. `vault` keeps them out of version control; `repo` writes them into the project at `#sidenote.repoNotesPath#`."
        },
        "sidenote.repoNotesPath": {
          "type": "string",
          "default": ".notes",
          "markdownDescription": "Project-relative folder for notes, used only when `#sidenote.projectNotesLocation#` is `repo`."
        },
        "sidenote.defaultScope": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "enumDescriptions": [
            "Store new notes with the current project",
            "Store new notes in the global folder"
          ],
          "default": "workspace",
          "description": "Where new notes are created when no folder is selected."
        },
        "sidenote.sortBy": {
          "type": "string",
          "enum": [
            "modifiedDesc",
            "modifiedAsc",
            "titleAsc",
            "titleDesc",
            "createdDesc"
          ],
          "enumDescriptions": [
            "Recently modified first",
            "Oldest modified first",
            "Alphabetical by title (A-Z)",
            "Alphabetical by title (Z-A)",
            "Recently created first"
          ],
          "default": "modifiedDesc",
          "description": "Sort order for notes within folders and sections."
        },
        "sidenote.showTags": {
          "type": "boolean",
          "default": true,
          "description": "Show the Tags section in the sidebar."
        },
        "sidenote.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show a quick New Note button in the status bar."
        },
        "sidenote.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deleting a note or folder."
        },
        "sidenote.defaultNoteTemplate": {
          "type": "string",
          "default": "# ${title}\n\n",
          "markdownDescription": "Content used for new notes. Supports `${title}`, `${date}`, `${time}` and `${datetime}`."
        },
        "sidenote.dailyNoteTemplate": {
          "type": "string",
          "default": "# ${date}\n\n- [ ] \n",
          "markdownDescription": "Content used for daily notes. Supports `${title}`, `${date}`, `${time}` and `${datetime}`."
        },
        "sidenote.dailyNoteFolder": {
          "type": "string",
          "default": "Daily",
          "description": "Folder inside the notes root where daily notes are stored. Leave empty to use the root."
        },
        "sidenote.dateFormat": {
          "type": "string",
          "default": "YYYY-MM-DD",
          "markdownDescription": "Date pattern for templates and daily note filenames. Supports `YYYY`, `MM`, `DD`, `HH`, `mm`, `ss`."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "sidenote.explorer",
        "when": "sidenote.isEmpty",
        "contents": "Notes you write here are kept outside your project, so they are never committed by accident.\n\n[New Note](command:sidenote.newNote)\n[Today's Daily Note](command:sidenote.openDailyNote)\n\nOr just start typing in the Quick Note box above."
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "node esbuild.js --production",
    "build-dev": "node esbuild.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run compile && mocha",
    "test:coverage": "npm run compile && c8 --check-coverage mocha",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "@types/vscode": "1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vscode/vsce": "^3.9.2",
    "c8": "^10.1.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "mocha": "^12.0.0",
    "typescript": "^5.9.3"
  }
}
